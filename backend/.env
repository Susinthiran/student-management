# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=mysql@123
DB_NAME=student_management
DB_PORT=3306

# JWT Secret & Expiry
